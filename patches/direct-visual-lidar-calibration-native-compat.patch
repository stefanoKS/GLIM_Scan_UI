diff --git a/include/vlcal/common/ceres_se3_parameterization.hpp b/include/vlcal/common/ceres_se3_parameterization.hpp
new file mode 100644
--- /dev/null
+++ b/include/vlcal/common/ceres_se3_parameterization.hpp
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <ceres/version.h>
+#include <sophus/se3.hpp>
+
+#if CERES_VERSION_MAJOR > 2 || (CERES_VERSION_MAJOR == 2 && CERES_VERSION_MINOR >= 1)
+#include <sophus/ceres_manifold.hpp>
+namespace vlcal {
+using SE3Parameterization = Sophus::Manifold<Sophus::SE3>;
+}
+#else
+#include <ceres/local_parameterization.h>
+
+namespace vlcal {
+// Ceres 2.0 uses LocalParameterization. Keep the same right-multiplicative
+// SE(3) update and Jacobian as Sophus::Manifold for both calibration solvers.
+class SE3Parameterization : public ceres::LocalParameterization {
+public:
+  bool Plus(const double* x, const double* delta, double* result) const override {
+    const Eigen::Map<const Sophus::SE3d> pose(x);
+    const Eigen::Map<const Sophus::SE3d::Tangent> tangent(delta);
+    Eigen::Map<Sophus::SE3d> updated(result);
+    updated = pose * Sophus::SE3d::exp(tangent);
+    return true;
+  }
+
+  bool ComputeJacobian(const double* x, double* result) const override {
+    const Eigen::Map<const Sophus::SE3d> pose(x);
+    Eigen::Map<Eigen::Matrix<double, Sophus::SE3d::num_parameters,
+                             Sophus::SE3d::DoF, Eigen::RowMajor>> jacobian(result);
+    jacobian = pose.Dx_this_mul_exp_x_at_0();
+    return true;
+  }
+
+  int GlobalSize() const override { return Sophus::SE3d::num_parameters; }
+  int LocalSize() const override { return Sophus::SE3d::DoF; }
+};
+}  // namespace vlcal
+#endif
